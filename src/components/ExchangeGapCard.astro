---
interface Props {
  percentage: number | null;
}

const { percentage } = Astro.props;

const isPositive = percentage !== null && percentage >= 0;
const pillText =
  percentage === null ? "No disponible" : `${percentage.toFixed(2)}%`;
const delta =
  percentage === null
    ? "No disponible"
    : `${isPositive ? "+" : ""}${percentage.toFixed(2)}%`;
const tooltip =
  percentage === null
    ? "Brecha no disponible: falta la tasa BCV o USDT"
    : `Diferencia entre BCV y USDT (${delta})`;
const pillColor =
  percentage === null
    ? "bg-white/5 text-white/45"
    : isPositive
      ? "bg-positive/10 text-positive/75"
      : "bg-negative/10 text-negative/75";
---

<div class="mx-auto flex w-fit items-center justify-center gap-2 text-center">
  <p class="text-xs font-medium tracking-[0.12em] text-white/45">
    BRECHA CAMBIARIA
  </p>

  {/* Change percentage pill */}
  <span class="group relative inline-flex">
    <span
      tabindex="0"
      aria-label={delta}
      data-exchange-gap
      class={`shrink-0 cursor-help rounded-md px-2 py-1 text-xs font-medium ${pillColor}`}
    >
      {pillText}
    </span>
    <span
      role="tooltip"
      class="pointer-events-none absolute bottom-[calc(100%+0.5rem)] left-1/2 z-10 w-max max-w-52 -translate-x-1/2 rounded-md bg-black/90 px-2 py-1 text-left text-[11px] font-medium tracking-normal text-white/90 opacity-0 transition-opacity duration-150 group-focus-within:opacity-100 group-hover:opacity-100"
    >
      {tooltip}
    </span>
  </span>
</div>
